---
const {
  title,
  desc,
  big,
  header,
}: {
  title: string;
  desc?: string;
  big?: boolean;
  header?: boolean;
} = Astro.props;
---

{!header && <hr />}
<div class="pt-2" id={title.replaceAll(" ", "-")}>
  <h2 class=`font-bold ${big && 'text-2xl'}`>{"->"} {title}</h2>
  {desc ? <p class="pb-2">{desc}</p> : null}

  <ol>
    <slot />
  </ol>
</div>
